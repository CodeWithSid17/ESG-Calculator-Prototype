# ==========================================
# Python & Django Rules
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Django local settings & database
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Django Media and Static uploads (User uploaded content / local static builds)
/media/
/staticfiles/

# Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Pytest / Coverage Reports
.cache
.pytest_cache/
htmlcov/
.coverage
.coverage.*

# ==========================================
# React / Node.js Rules
# ==========================================

# Dependencies
node_modules/
jspm_packages/

# Production / Build Out
build/
dist/
out/

# Node logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / IDE state for React / JS
.eslintcache
.stylelintcache
.next/
.nuxt/

# ==========================================
# IDEs, Editors & OS Files
# ==========================================

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# PyCharm / IntelliJ IDEA
.idea/

# macOS
.DS_Store
.AppleDouble
.lsfactorypath

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini

# Temporary files
*.swp
*~
*.bak